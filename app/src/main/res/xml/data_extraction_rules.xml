<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer (Hub ADR 0033). Nothing goes to cloud backup. Moving to a new phone by cable
     or the phone's transfer tool brings Niko Reminders' own files along. -->
<data-extraction-rules>
    <!-- allowBackup="false" already turns cloud backup off. Excluding every place as well keeps it off
         if a phone or a later Android ever reads these rules for the cloud too. -->
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <!-- Only the DataStore files for now. Add the folders for photos and recordings with the features
         that make them. -->
    <device-transfer>
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
